# Safe defaults: the backend uses a deterministic mock until explicitly disabled.
DAFEIYU_MOCK_MODE=true
DAFEIYU_BASE_URL=https://api.deepseek.com
DAFEIYU_MODEL=deepseek-flash
DAFEIYU_API_KEY=
DAFEIYU_DATABASE_URL=sqlite:///./agent.db
DAFEIYU_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DAFEIYU_DEVICE_TOKEN=
DAFEIYU_AUTOMATION_ENABLED=true

# AI_* aliases remain supported for deployments that already use them.
# AI_MOCK_MODE=true
# AI_PROVIDER_BASE_URL=https://api.deepseek.com
# AI_PROVIDER_MODEL=deepseek-flash
# AI_PROVIDER_API_KEY=

